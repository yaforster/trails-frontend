# Copy this file to trails-frontend.env and adjust the values for your environment.
# The frontend reads these values at build time for local Angular builds and at
# container startup time when served through Docker/nginx.

# Base URL of the Trails backend service. The browser must be able to reach this
# URL directly because the static frontend calls the API from the user's browser.
TRAILS_API_BASE_URL=http://localhost:8080

# Full Keycloak/OpenID Connect token endpoint used by the login form and token
# refresh logic.
TRAILS_KEYCLOAK_TOKEN_URL=http://localhost:8080/realms/master/protocol/openid-connect/token

# Host port used by docker compose when supplied as an interpolation environment
# value, for example with: docker compose --env-file trails-frontend.env up
TRAILS_FRONTEND_HOST_PORT=4200
